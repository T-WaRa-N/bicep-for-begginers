az account show --output table                                    # check current subscription
az acount list --output table                                     # to get the list of default subscritions in the az acount
az account set --subscription <subcription-id>                    # set a particular subscription
az account list --all                                             # list all subscriptions
az account subscription cancel --id "BicepSubscriptionLab"        # deleting a bicep subscription
az resource list --resource-group bicep-lap --output table        # displaying all the resources inside the az resource group
az resource list --output table                                   # this can be used to display the resource in the resource group/s
az group list --output table                     # this is to get the az group list in a particular subscription
az group create --name arm-learning-rg --location <location>
az group show --name exampleGroup
az group delete --name exampleGroup
az storage account create --resource-group exampleGroup --name examplestore --location westus --sku Standard_LRS --kind StorageV2
az account list-locations --output table                           # to fetch location 
az configure --defaults location=<location>                        # configure location
az configure --defaults group="<resource-group-name>"
az deployment group create --resource-group exampleGroup --template-file storage.bicep
az lock create --name LockGroup --lock-type CanNotDelete --resource-group exampleGroup
az lock delete --name exampleLock --resource-group exampleGroup



